      "surface": false,
      "duration": 4.5,
      "zoom": 1.15,
      "html": "<div class=\"rise\" style=\"--at: +0.6s\"><nve-card style=\"width: 550px\"><nve-media-controller id=\"aug-media\"><video id=\"aug-video\" src=\"/static/video/particle.mp4\" playsinline muted></video></nve-media-controller><nve-card-content role=\"toolbar\" aria-label=\"media controls\" style=\"--padding: var(--nve-ref-size-200) var(--nve-ref-size-400) var(--nve-ref-size-400) var(--nve-ref-size-400)\"><nve-media-time-range commandfor=\"aug-media\" name=\"currentTime\"></nve-media-time-range><div nve-layout=\"row gap:xs align:wrap full\"><nve-media-seek-button commandfor=\"aug-media\" action=\"start\"></nve-media-seek-button><nve-media-seek-button commandfor=\"aug-media\" action=\"backward\" value=\"3\"></nve-media-seek-button><nve-media-pause-button commandfor=\"aug-media\" name=\"paused\" checked value=\"true\"></nve-media-pause-button><nve-media-seek-button commandfor=\"aug-media\" action=\"forward\" value=\"3\"></nve-media-seek-button><nve-media-seek-button commandfor=\"aug-media\" action=\"end\"></nve-media-seek-button><nve-media-mute-button commandfor=\"aug-media\" name=\"muted\" value=\"true\" style=\"margin-left: auto\"></nve-media-mute-button><nve-media-volume-range commandfor=\"aug-media\" name=\"volume\" style=\"max-width: 100px\"></nve-media-volume-range><nve-media-playback-rate-select commandfor=\"aug-media\" name=\"playbackRate\"></nve-media-playback-rate-select><nve-media-fullscreen-button commandfor=\"aug-media\"></nve-media-fullscreen-button></div></nve-card-content></nve-card></div>",
