{
  "name": "sphinx-starter",
  "version": "0.0.0",
  "description": "NVIDIA Elements Sphinx starter",
  "private": true,
  "scripts": {
    "ci": "wireit",
    "build": "wireit",
    "dev": "wireit"
  },
  "dependencies": {
    "@nvidia-elements/code": "workspace:*",
    "@nvidia-elements/core": "workspace:*",
    "@nvidia-elements/markdown": "workspace:*",
    "@nvidia-elements/media": "workspace:*",
    "@nvidia-elements/monaco": "workspace:*",
    "@nvidia-elements/styles": "workspace:*",
    "@nvidia-elements/themes": "workspace:*"
  },
  "wireit": {
    "ci": {
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "uv run --locked sphinx-build -W --keep-going -n -b html docs dist",
      "files": [
        "docs/**",
        "pyproject.toml",
        "uv.lock",
        "package.json",
        "../../../mise.toml"
      ],
      "output": [
        "dist/**"
      ]
    },
    "dev": {
      "command": "uv run --locked sphinx-autobuild docs dist",
      "service": true
    }
  }
}
