{
  "name": "@nvidia-elements/scene",
  "version": "0.0.0",
  "release": {
    "extends": "../../release.config.js"
  },
  "description": "WebGPU Web Components for declarative robotics and autonomous-vehicle scenes.",
  "keywords": [
    "nvidia",
    "web-components",
    "custom-elements",
    "ui-components",
    "design-system"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NVIDIA/elements.git"
  },
  "customElements": "dist/custom-elements.json",
  "contributes": {
    "html": {
      "customData": [
        "./dist/data.html.json"
      ]
    },
    "snippets": [
      {
        "language": "html",
        "path": "./dist/data.snippets.json"
      }
    ]
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "package.json",
    "dist/**/*"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./data.html.json": "./dist/data.html.json",
    "./*.examples.json": "./dist/*.examples.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arrows": {
      "types": "./dist/arrows/index.d.ts",
      "default": "./dist/arrows/index.js"
    },
    "./arrows/define.js": {
      "types": "./dist/arrows/define.d.ts",
      "default": "./dist/arrows/define.js"
    },
    "./axes": {
      "types": "./dist/axes/index.d.ts",
      "default": "./dist/axes/index.js"
    },
    "./axes/define.js": {
      "types": "./dist/axes/define.d.ts",
      "default": "./dist/axes/define.js"
    },
    "./camera": {
      "types": "./dist/camera/index.d.ts",
      "default": "./dist/camera/index.js"
    },
    "./camera/define.js": {
      "types": "./dist/camera/define.d.ts",
      "default": "./dist/camera/define.js"
    },
    "./cones": {
      "types": "./dist/cones/index.d.ts",
      "default": "./dist/cones/index.js"
    },
    "./cones/define.js": {
      "types": "./dist/cones/define.d.ts",
      "default": "./dist/cones/define.js"
    },
    "./cubes": {
      "types": "./dist/cubes/index.d.ts",
      "default": "./dist/cubes/index.js"
    },
    "./cubes/define.js": {
      "types": "./dist/cubes/define.d.ts",
      "default": "./dist/cubes/define.js"
    },
    "./cylinders": {
      "types": "./dist/cylinders/index.d.ts",
      "default": "./dist/cylinders/index.js"
    },
    "./cylinders/define.js": {
      "types": "./dist/cylinders/define.d.ts",
      "default": "./dist/cylinders/define.js"
    },
    "./frame": {
      "types": "./dist/frame/index.d.ts",
      "default": "./dist/frame/index.js"
    },
    "./frame/define.js": {
      "types": "./dist/frame/define.d.ts",
      "default": "./dist/frame/define.js"
    },
    "./gridlines": {
      "types": "./dist/gridlines/index.d.ts",
      "default": "./dist/gridlines/index.js"
    },
    "./gridlines/define.js": {
      "types": "./dist/gridlines/define.d.ts",
      "default": "./dist/gridlines/define.js"
    },
    "./heightfield": {
      "types": "./dist/heightfield/index.d.ts",
      "default": "./dist/heightfield/index.js"
    },
    "./heightfield/define.js": {
      "types": "./dist/heightfield/define.d.ts",
      "default": "./dist/heightfield/define.js"
    },
    "./label": {
      "types": "./dist/label/index.d.ts",
      "default": "./dist/label/index.js"
    },
    "./label/define.js": {
      "types": "./dist/label/define.d.ts",
      "default": "./dist/label/define.js"
    },
    "./lines": {
      "types": "./dist/lines/index.d.ts",
      "default": "./dist/lines/index.js"
    },
    "./lines/define.js": {
      "types": "./dist/lines/define.d.ts",
      "default": "./dist/lines/define.js"
    },
    "./marker": {
      "types": "./dist/marker/index.d.ts",
      "default": "./dist/marker/index.js"
    },
    "./marker/define.js": {
      "types": "./dist/marker/define.d.ts",
      "default": "./dist/marker/define.js"
    },
    "./mesh": {
      "types": "./dist/mesh/index.d.ts",
      "default": "./dist/mesh/index.js"
    },
    "./mesh/define.js": {
      "types": "./dist/mesh/define.d.ts",
      "default": "./dist/mesh/define.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./model/define.js": {
      "types": "./dist/model/define.d.ts",
      "default": "./dist/model/define.js"
    },
    "./points": {
      "types": "./dist/points/index.d.ts",
      "default": "./dist/points/index.js"
    },
    "./points/define.js": {
      "types": "./dist/points/define.d.ts",
      "default": "./dist/points/define.js"
    },
    "./pyramids": {
      "types": "./dist/pyramids/index.d.ts",
      "default": "./dist/pyramids/index.js"
    },
    "./pyramids/define.js": {
      "types": "./dist/pyramids/define.d.ts",
      "default": "./dist/pyramids/define.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "default": "./dist/scene/index.js"
    },
    "./scene/define.js": {
      "types": "./dist/scene/define.d.ts",
      "default": "./dist/scene/define.js"
    },
    "./spheres": {
      "types": "./dist/spheres/index.d.ts",
      "default": "./dist/spheres/index.js"
    },
    "./spheres/define.js": {
      "types": "./dist/spheres/define.d.ts",
      "default": "./dist/spheres/define.js"
    },
    "./triangles": {
      "types": "./dist/triangles/index.d.ts",
      "default": "./dist/triangles/index.js"
    },
    "./triangles/define.js": {
      "types": "./dist/triangles/define.d.ts",
      "default": "./dist/triangles/define.js"
    },
    "./bundles/*": {
      "default": "./dist/bundles/*"
    }
  },
  "sideEffects": [
    "./src/**/define.ts",
    "./dist/bundles/*.js",
    "./**/define.js"
  ],
  "scripts": {
    "ci": "wireit",
    "dev": "wireit",
    "build": "wireit",
    "build:watch": "wireit",
    "lint": "wireit",
    "lint:style": "wireit",
    "test": "wireit",
    "test:axe": "wireit",
    "test:coverage": "wireit",
    "test:ssr": "wireit",
    "test:visual": "wireit",
    "test:watch": "wireit",
    "test:lighthouse": "wireit"
  },
  "dependencies": {
    "lit": "catalog:publish"
  },
  "peerDependencies": {
    "@nvidia-elements/core": "workspace:^",
    "@nvidia-elements/themes": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@nvidia-elements/styles": "workspace:*",
    "@internals/testing": "workspace:*",
    "@internals/eslint": "workspace:*",
    "@internals/vite": "workspace:*",
    "@nvidia-elements/lint": "workspace:*",
    "@nvidia-elements/media": "workspace:*",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "lit": "catalog:",
    "publint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "wireit": {
    "dev": {
      "command": "NODE_ENV=development vite build --watch",
      "service": true,
      "dependencies": [
        "../core:build",
        "../internals/vite:ci"
      ]
    },
    "ci": {
      "dependencies": [
        "build",
        "lint",
        "publint",
        "test:axe",
        "test:ssr",
        "test:coverage",
        "test:visual"
      ]
    },
    "publint": {
      "command": "publint",
      "dependencies": [
        "build"
      ],
      "files": [
        "package.json"
      ],
      "output": []
    },
    "build": {
      "command": "NODE_ENV=production vite build",
      "files": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.lighthouse.ts",
        "!src/**/*.test.axe.ts",
        "!src/**/*.test.ssr.ts",
        "!src/**/__screenshots__/**",
        "package.json",
        "custom-elements-manifest.config.mjs",
        "tsconfig.json",
        "tsconfig.lib.json",
        "vite.config.ts",
        "vite.bundle.ts"
      ],
      "output": [
        "dist/**"
      ],
      "dependencies": [
        "../internals/vite:ci",
        {
          "script": "../themes:build",
          "cascade": false
        },
        {
          "script": "../core:build",
          "cascade": false
        }
      ]
    },
    "build:watch": {
      "command": "vite build --watch",
      "service": true,
      "dependencies": [
        "build"
      ]
    },
    "test": {
      "command": "vitest run",
      "files": [
        "src/**",
        "!src/**/*.test.axe.ts",
        "!src/**/*.test.lighthouse.ts",
        "!src/**/*.test.ssr.ts",
        "!src/**/*.test.visual.ts",
        "!src/**/__screenshots__/**",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "output": [],
      "dependencies": [
        "../internals/testing:build",
        "../internals/vite:ci",
        "../core:build"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "files": [
        "src/**",
        "!src/**/*.test.axe.ts",
        "!src/**/*.test.lighthouse.ts",
        "!src/**/*.test.ssr.ts",
        "!src/**/*.test.visual.ts",
        "!src/**/__screenshots__/**",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "output": [
        "coverage/unit/**"
      ],
      "dependencies": [
        "../internals/testing:build",
        "../internals/vite:ci",
        "../core:build"
      ]
    },
    "test:watch": {
      "command": "vitest --watch",
      "service": true
    },
    "test:lighthouse": {
      "command": "playwright-lock 'vitest run --config=vitest.lighthouse.ts'",
      "files": [
        "src/index.test.lighthouse.ts",
        "src/**/*.test.lighthouse.ts",
        "vitest.lighthouse.html",
        "vitest.lighthouse.ts"
      ],
      "output": [
        ".lighthouse"
      ],
      "dependencies": [
        "build",
        "../internals/vite:ci"
      ],
      "env": {
        "NODE_ENV": "production"
      }
    },
    "test:visual": {
      "command": "vitest run --config=vitest.visual.ts",
      "clean": false,
      "files": [
        "dist/**/*.js",
        "src/**/*.test.visual.ts",
        "vitest.visual.html",
        "vitest.visual.ts"
      ],
      "output": [
        ".visual/*.png",
        "coverage/visual/**"
      ],
      "dependencies": [
        "../internals/vite:ci",
        {
          "script": "build",
          "cascade": false
        }
      ]
    },
    "test:axe": {
      "command": "vitest run --config=vitest.axe.ts",
      "files": [
        "dist/**/*.js",
        "src/**/*.test.axe.ts",
        "tsconfig.json",
        "vitest.axe.ts"
      ],
      "output": [
        "coverage/axe/**"
      ],
      "dependencies": [
        "../internals/testing:build",
        "../internals/vite:ci",
        {
          "script": "build",
          "cascade": false
        }
      ],
      "env": {
        "NODE_ENV": "production"
      }
    },
    "test:ssr": {
      "command": "vitest run --config=vitest.ssr.ts",
      "files": [
        "dist/**/*.js",
        "src/**/*.test.ssr.ts",
        "tsconfig.json",
        "vitest.ssr.ts",
        "../themes/dist/**/*.css"
      ],
      "output": [
        "coverage/ssr/**"
      ],
      "dependencies": [
        "../internals/vite:ci",
        {
          "script": "build",
          "cascade": false
        },
        {
          "script": "../themes:build",
          "cascade": false
        }
      ],
      "env": {
        "NODE_ENV": "production"
      }
    },
    "lint": {
      "dependencies": [
        "lint:eslint",
        "lint:style"
      ]
    },
    "lint:eslint": {
      "command": "eslint -c ./eslint.config.js --color --cache --cache-location .eslintcache/",
      "files": [
        "src/**/*.ts",
        "eslint.config.js"
      ],
      "output": [],
      "dependencies": [
        "../internals/eslint:ci",
        "../lint:build"
      ]
    },
    "lint:style": {
      "command": "stylelint 'src/**/*.css' --config=../../stylelint.config.mjs",
      "files": [
        "src/**/*.css",
        "../../stylelint.config.mjs"
      ],
      "output": []
    },
    "lint:fix": {
      "command": "eslint -c ./eslint.config.js --fix",
      "dependencies": [
        "../internals/eslint:ci",
        "../lint:build"
      ]
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "license": "Apache-2.0"
}
