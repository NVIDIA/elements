diff --git a/esm/vs/base/browser/motion.js b/esm/vs/base/browser/motion.js
new file mode 100644
--- /dev/null
+++ b/esm/vs/base/browser/motion.js
@@ -0,0 +1,14 @@
+// PATCH: Read local motion durations for numeric animations and dismissal timers.
+function getMotionDuration(element, property, fallback) {
+    if (!element) {
+        return fallback;
+    }
+    const value = element.ownerDocument.defaultView?.getComputedStyle(element).getPropertyValue(property).trim();
+    const time = value?.match(/^(\d+(?:\.\d+)?|\.\d+)(ms|s)$/);
+    if (!time) {
+        return fallback;
+    }
+    const duration = Number(time[1]) * (time[2] === 's' ? 1000 : 1);
+    return Number.isFinite(duration) ? duration : fallback;
+}
+export { getMotionDuration };
